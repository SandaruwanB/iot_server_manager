<%- include('./imports/top', { title: 'Users' }) %>
<body>
    <div class="bg-grid"></div>
    <div class="app-shell">
        <%- include('./components/navbar') %>

        <div class="content-wrap">
            <%- include('./components/sidebar', { active: 'users' }) %>
            <div class="sidebar-overlay" id="sidebar-overlay"></div>

            <main class="dashboard-main">
                <div class="page-header-row">
                    <div>
                        <h1 class="page-heading">User <span>Management</span></h1>
                        <p class="page-subheading">Manage system users</p>
                    </div>
                    <div class="page-header-actions">
                        <span class="users-total-badge"><%= pagination.total %> total</span>
                        <a href="/web/users/create" class="btn-primary" >
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="14" height="14"><path d="M12 5v14M5 12h14"/></svg>
                            Create User
                        </a>
                    </div>
                </div>

                <div class="table-toolbar">
                    <form method="GET" action="/web/users" class="search-form" id="search-form">
                        <div class="search-wrap">
                            <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/>
                            </svg>
                            <input type="text" name="search" class="search-input"
                                placeholder="Search by name, username or email&hellip;"
                                value="<%= search %>" autocomplete="off" />
                            <% if (search) { %>
                            <a href="/web/users" class="search-clear" title="Clear">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="14" height="14"><path d="M18 6L6 18M6 6l12 12"/></svg>
                            </a>
                            <% } %>
                        </div>
                        <input type="hidden" name="limit" value="<%= pagination.limit %>"/>
                    </form>
                </div>

                <div class="table-wrap">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>#</th>
                                <th>Name</th>
                                <th>Username</th>
                                <th>Email</th>
                                <th>Role</th>
                                <th>Created</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (users.length === 0) { %>
                            <tr>
                                <td colspan="6" class="table-empty">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" width="32" height="32"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
                                    <span>No users found<% if (search) { %> for &ldquo;<%= search %>&rdquo;<% } %></span>
                                </td>
                            </tr>
                            <% } else { users.forEach((user, idx) => { %>
                            <tr>
                                <td class="td-num"><%= (pagination.page - 1) * pagination.limit + idx + 1 %></td>
                                <td class="td-name">
                                    <div class="user-avatar"><%= user.name.charAt(0).toUpperCase() %></div>
                                    <span><%= user.name %></span>
                                </td>
                                <td class="td-mono"><%= user.user_name %></td>
                                <td class="td-mono"><%= user.email %></td>
                                <td>
                                    <span class="role-badge <%= user.is_superuser ? 'role-super' : 'role-user' %>">
                                        <%= user.is_superuser ? 'Superuser' : 'User' %>
                                    </span>
                                </td>
                                <td class="td-date"><%= new Date(user.created_at).toLocaleDateString('en-US', { year:'numeric', month:'short', day:'numeric' }) %></td>
                            </tr>
                            <% }) } %>
                        </tbody>
                    </table>
                </div>

                <% if (users.length > 0) { %>
                <div class="pagination-bar">
                    <span class="pagination-info">
                        Showing <%= (pagination.page - 1) * pagination.limit + 1 %>&ndash;<%= Math.min(pagination.page * pagination.limit, pagination.total) %> of <%= pagination.total %>
                    </span>
                    <div class="pagination-controls">
                        <%
                        function pageUrl(p) {
                            const params = new URLSearchParams();
                            params.set('page', p);
                            params.set('limit', pagination.limit);
                            if (search) params.set('search', search);
                            return '/web/users?' + params.toString();
                        }
                        %>
                        <a href="<%= pageUrl(1) %>" class="page-btn <%= pagination.page === 1 ? 'disabled' : '' %>" title="First">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="14" height="14"><path d="M11 17l-5-5 5-5M18 17l-5-5 5-5"/></svg>
                        </a>
                        <a href="<%= pageUrl(Math.max(1, pagination.page - 1)) %>" class="page-btn <%= pagination.page === 1 ? 'disabled' : '' %>" title="Previous">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="14" height="14"><path d="M15 18l-6-6 6-6"/></svg>
                        </a>
                        <% for (let p = Math.max(1, pagination.page - 2); p <= Math.min(pagination.totalPages, pagination.page + 2); p++) { %>
                        <a href="<%= pageUrl(p) %>" class="page-btn <%= p === pagination.page ? 'active' : '' %>"><%= p %></a>
                        <% } %>
                        <a href="<%= pageUrl(Math.min(pagination.totalPages, pagination.page + 1)) %>" class="page-btn <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>" title="Next">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="14" height="14"><path d="M9 18l6-6-6-6"/></svg>
                        </a>
                        <a href="<%= pageUrl(pagination.totalPages) %>" class="page-btn <%= pagination.page === pagination.totalPages ? 'disabled' : '' %>" title="Last">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="14" height="14"><path d="M13 17l5-5-5-5M6 17l5-5-5-5"/></svg>
                        </a>
                    </div>
                    <div class="pagination-limit">
                        <span>Rows</span>
                        <select class="limit-select" onchange="changeLimit(this.value)">
                            <% [10, 25, 50].forEach(n => { %>
                            <option value="<%= n %>" <%= pagination.limit === n ? 'selected' : '' %>><%= n %></option>
                            <% }) %>
                        </select>
                    </div>
                </div>
                <% } %>

            </main>
        </div>
    </div>
    <%# Create User Modal %>
    <div class="modal-backdrop" id="create-modal" onclick="closeCreateModal(event)">
        <div class="modal-box">
            <div class="modal-header">
                <h2 class="modal-title">Create User</h2>
                <button class="modal-close" onclick="closeCreateModal()">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" width="16" height="16"><path d="M18 6L6 18M6 6l12 12"/></svg>
                </button>
            </div>
            <div id="create-alert" class="modal-alert" style="display:none;"></div>
            <form class="modal-form" id="create-user-form" onsubmit="submitCreateUser(event)">
                <div class="field-group">
                    <label class="field-label">Full Name</label>
                    <div class="field-wrap">
                        <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <input type="text" name="name" class="field-input" placeholder="John Doe" required />
                    </div>
                </div>
                <div class="field-group">
                    <label class="field-label">Username</label>
                    <div class="field-wrap">
                        <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        <input type="text" name="user_name" class="field-input" placeholder="johndoe" required />
                    </div>
                </div>
                <div class="field-group">
                    <label class="field-label">Email</label>
                    <div class="field-wrap">
                        <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 4h16v16H4z" rx="2"/><path d="M22 6l-10 7L2 6"/></svg>
                        <input type="email" name="email" class="field-input" placeholder="john@example.com" required />
                    </div>
                </div>
                <div class="field-group">
                    <label class="field-label">Password</label>
                    <div class="field-wrap">
                        <svg class="field-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
                        <input type="password" name="password" class="field-input" placeholder="Min. 8 characters" required minlength="8" />
                    </div>
                </div>
                <div class="field-group">
                    <label class="field-label modal-checkbox-label">
                        <input type="checkbox" name="is_superuser" class="modal-checkbox" />
                        Superuser
                    </label>
                </div>
                <button type="submit" class="btn-primary btn-full" id="create-submit-btn">Create User</button>
            </form>
        </div>
    </div>

    <%- include('./imports/js') %>
</body>
</html>