<%- include('./imports/top', { title: 'Dashboard' }) %>
<body>
    <div class="bg-grid"></div>
    <div class="app-shell">
        <%- include('./components/navbar') %>

        <div class="content-wrap">
            <%- include('./components/sidebar', { active: 'dashboard' }) %>
            <div class="sidebar-overlay" id="sidebar-overlay"></div>

            <main class="dashboard-main">
                <div class="page-header-row">
                    <div>
                        <h1 class="page-heading">Climate <span>Monitor</span></h1>
                        <p class="page-subheading">Real-time DHT22 temperature &amp; humidity sensor</p>
                    </div>
                    <div id="last-updated" class="page-timestamp">Waiting for sensor data&hellip;</div>
                </div>

                <div class="gauges">
                    <div class="gauge-card">
                        <div class="gauge-title">Temperature</div>
                        <svg class="gauge-svg" viewBox="0 0 200 200">
                            <circle class="gauge-track" cx="100" cy="100" r="80"
                                stroke-dasharray="376.99 125.66"
                                transform="rotate(135 100 100)" />
                            <circle id="temp-fill" class="gauge-fill" cx="100" cy="100" r="80"
                                stroke="#38bdf8"
                                stroke-dasharray="0 502.65"
                                transform="rotate(135 100 100)" />
                            <text id="temp-value" class="gauge-value" x="100" y="95">--</text>
                            <text class="gauge-unit" x="100" y="128">°C</text>
                        </svg>
                        <div class="gauge-range"><span>-40°C</span><span>80°C</span></div>
                        <div class="stats">
                            <div class="stat">
                                <span class="stat-label">Min</span>
                                <span class="stat-val" id="temp-min">--</span>
                            </div>
                            <div class="stat">
                                <span class="stat-label">Max</span>
                                <span class="stat-val" id="temp-max">--</span>
                            </div>
                        </div>
                    </div>

                    <div class="gauge-card">
                        <div class="gauge-title">Humidity</div>
                        <svg class="gauge-svg" viewBox="0 0 200 200">
                            <circle class="gauge-track" cx="100" cy="100" r="80"
                                stroke-dasharray="376.99 125.66"
                                transform="rotate(135 100 100)" />
                            <circle id="hum-fill" class="gauge-fill" cx="100" cy="100" r="80"
                                stroke="#38bdf8"
                                stroke-dasharray="0 502.65"
                                transform="rotate(135 100 100)" />
                            <text id="hum-value" class="gauge-value" x="100" y="95">--</text>
                            <text class="gauge-unit" x="100" y="128">%</text>
                        </svg>
                        <div class="gauge-range"><span>0%</span><span>100%</span></div>
                        <div class="stats">
                            <div class="stat">
                                <span class="stat-label">Min</span>
                                <span class="stat-val" id="hum-min">--</span>
                            </div>
                            <div class="stat">
                                <span class="stat-label">Max</span>
                                <span class="stat-val" id="hum-max">--</span>
                            </div>
                        </div>
                    </div>
                </div>

            </main>
        </div>
    </div>

    <%- include('./imports/js') %>
</body>
</html>
