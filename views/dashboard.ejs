<%- include('./imports/top', { title: 'Dashboard' }) %>
<body>
    <div class="bg-grid"></div>
    <div class="app-shell">
        <%- include('./components/navbar') %>

        <div class="content-wrap">
            <%- include('./components/sidebar', { active: 'dashboard' }) %>
            <div class="sidebar-overlay" id="sidebar-overlay"></div>

            <main class="dashboard-main">
                <div class="page-header-row">
                    <div>
                        <h1 class="page-heading">Server <span>Monitor</span></h1>
                        <p class="page-subheading">Realtime Temperature &amp; Monitor</p>
                    </div>
                    <div id="last-updated" class="page-timestamp">Waiting for sensor data&hellip;</div>
                </div>

                <div class="section-label">Overall Room Temperature &amp; Humidity</div>
                <div class="dht-row">
                    <div class="gauges">
                        <div class="gauge-card">
                            <div class="gauge-title">Temperature</div>
                            <svg class="gauge-svg" viewBox="0 0 200 200">
                                <circle class="gauge-track" cx="100" cy="100" r="80"
                                    stroke-dasharray="376.99 125.66"
                                    transform="rotate(135 100 100)" />
                                <circle id="temp-fill" class="gauge-fill" cx="100" cy="100" r="80"
                                    stroke="#38bdf8"
                                    stroke-dasharray="0 502.65"
                                    transform="rotate(135 100 100)" />
                                <text id="temp-value" class="gauge-value" x="100" y="95">--</text>
                                <text class="gauge-unit" x="100" y="128">°C</text>
                            </svg>
                            <div class="gauge-range"><span>-40°C</span><span>80°C</span></div>
                            <div class="stats">
                                <div class="stat">
                                    <span class="stat-label">Min</span>
                                    <span class="stat-val" id="temp-min">--</span>
                                </div>
                                <div class="stat">
                                    <span class="stat-label">Max</span>
                                    <span class="stat-val" id="temp-max">--</span>
                                </div>
                            </div>
                        </div>

                        <div class="gauge-card">
                            <div class="gauge-title">Humidity</div>
                            <svg class="gauge-svg" viewBox="0 0 200 200">
                                <circle class="gauge-track" cx="100" cy="100" r="80"
                                    stroke-dasharray="376.99 125.66"
                                    transform="rotate(135 100 100)" />
                                <circle id="hum-fill" class="gauge-fill" cx="100" cy="100" r="80"
                                    stroke="#38bdf8"
                                    stroke-dasharray="0 502.65"
                                    transform="rotate(135 100 100)" />
                                <text id="hum-value" class="gauge-value" x="100" y="95">--</text>
                                <text class="gauge-unit" x="100" y="128">%</text>
                            </svg>
                            <div class="gauge-range"><span>0%</span><span>100%</span></div>
                            <div class="stats">
                                <div class="stat">
                                    <span class="stat-label">Min</span>
                                    <span class="stat-val" id="hum-min">--</span>
                                </div>
                                <div class="stat">
                                    <span class="stat-label">Max</span>
                                    <span class="stat-val" id="hum-max">--</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="server-status-card">
                        <div class="server-status-title">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" width="15" height="15">
                                <rect x="2" y="2" width="20" height="8" rx="2"/><rect x="2" y="14" width="20" height="8" rx="2"/>
                                <circle cx="18" cy="6" r="1.2" fill="currentColor" stroke="none"/>
                                <circle cx="18" cy="18" r="1.2" fill="currentColor" stroke="none"/>
                            </svg>
                            Server Status
                        </div>
                        <div class="server-single">
                            <span class="server-dot" id="server-dot"></span>
                            <span class="server-single-label" id="server-status-label">Unknown</span>
                        </div>
                        <div class="server-badge-wrap">
                            <span class="server-badge" id="server-badge">Unknown</span>
                        </div>
                    </div>
                </div>

                <div class="section-label" style="margin-top:36px;">Probe Temperatures</div>
                <div class="probe-cards">
                    <% for (let i = 0; i < 4; i++) { %>
                    <div class="probe-card">
                        <div class="probe-header">
                            <svg class="probe-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M14 14.76V3.5a2.5 2.5 0 0 0-5 0v11.26a4.5 4.5 0 1 0 5 0z"/>
                            </svg>
                            <span class="probe-name">Probe <%= i + 1 %></span>
                        </div>
                        <div class="probe-value-wrap">
                            <span class="probe-value" id="probe-<%= i %>-value">--</span>
                            <span class="probe-unit">°C</span>
                        </div>
                        <div class="probe-bar-wrap">
                            <div class="probe-bar-track">
                                <div class="probe-bar-fill" id="probe-<%= i %>-bar"></div>
                            </div>
                            <div class="probe-bar-range"><span>-55°C</span><span>125°C</span></div>
                        </div>
                        <div class="stats">
                            <div class="stat">
                                <span class="stat-label">Min</span>
                                <span class="stat-val" id="probe-<%= i %>-min">--</span>
                            </div>
                            <div class="stat">
                                <span class="stat-label">Max</span>
                                <span class="stat-val" id="probe-<%= i %>-max">--</span>
                            </div>
                        </div>
                    </div>
                    <% } %>
                </div>

            </main>
        </div>
    </div>

    <%- include('./imports/js') %>
</body>
</html>
