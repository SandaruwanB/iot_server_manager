<%- include('../imports/top', { title: 'Reset Password' }) %>
<body>
    <div class="bg-grid"></div>

    <div class="main">
        <%- include('../components/header') %>

        <div class="center-container">
            <div class="login-card">

                <div class="card-header">
                    <div class="card-icon-container">
                        <div class="card-icon">
                            <svg class="brand-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M3 15a4 4 0 004 4h9a5 5 0 10-4.584-7.002A4 4 0 003 15z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </div>
                    </div>
                    <h1 class="card-title">Verify OTP</h1>
                    <p class="card-subtitle">Enter the OTP sent to your email address</p>
                </div>

                <% if (typeof error !== 'undefined' && error) { %>
                    <div class="alert alert-error">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 9v4m0 4h.01M10.29 3.86l-8.19 14.2A2 2 0 003.83 21h16.34a2 2 0 001.73-3l-8.19-14.14a2 2 0 00-3.42.0z" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        <%= error %>
                    </div>
                <% } %>

                <form id="login-form" class="login-form" autocomplete="off" novalidate>

                    <div class="field-group">
                        <label for="otp" class="field-label">OTP</label>
                        <div class="field-wrap">
                            <svg class="field-icon" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <circle cx="5" cy="12" r="1.5" fill="currentColor"/>
                                <circle cx="12" cy="12" r="1.5" fill="currentColor"/>
                                <circle cx="19" cy="12" r="1.5" fill="currentColor"/>
                                <rect x="2" y="5" width="20" height="14" rx="3" stroke="currentColor" stroke-width="1.8"/>
                            </svg>
                            <input type="text" id="otp" name="otp" class="field-input" placeholder="Enter OTP" required autocomplete="one-time-code">
                        </div>
                    </div>

                    <button type="submit" class="btn-submit" id="btn-submit">
                        <span class="btn-text">Verify</span>
                        <svg class="btn-arrow" viewBox="0 0 24 24" fill="none">
                            <path d="M5 12h14M13 6l6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        <svg class="btn-spinner" viewBox="0 0 24 24" fill="none">
                            <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="2.5" stroke-dasharray="56.5" stroke-dashoffset="42" stroke-linecap="round"/>
                        </svg>
                    </button>
                </form>

                <div class="card-linkback">
                    <a href="/web/login">Back to Login</a>
                </div>

                <div class="card-footer">
                    <span class="footer-info">
                        <svg viewBox="0 0 24 24" fill="none"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                        Secured &mdash; Local network only
                    </span>
                </div>

            </div>
        </div>

        <%- include('../components/footer') %>

    </div>

    <script src="/static/js/common.js"></script>
    <script src="/static/js/script.js"></script>
</body>
</html>